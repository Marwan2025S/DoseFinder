# Database Configuration
DB_HOST=localhost
DB_USER=dms_user
DB_PASSWORD=dms_secure_password
DB_NAME=dms_db
DB_ROOT_PASSWORD=dms_root_password

# JWT Configuration (Must be >= 32 characters)
JWT_SECRET=this_is_a_very_secure_and_long_jwt_secret_key_for_dms_123456
# Optional separate HMAC key for stored session/device hashes. Falls back to JWT_SECRET when blank.
AUTH_HASH_SECRET=

# Google Sign-In (Sign in with Google)
# Create an OAuth 2.0 "Web application" client in Google Cloud Console
# (APIs & Services > Credentials). Add http://localhost:8080 under
# "Authorized JavaScript origins". Both variables take the SAME Client ID:
#   - GOOGLE_CLIENT_ID is used by the backend to verify Google ID tokens.
#   - VITE_GOOGLE_CLIENT_ID is exposed to the frontend to render the button.
# Leave both blank to disable Google sign-in (the button simply won't render).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Ollama Configuration
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2
# Leave blank for local Ollama. For direct cloud access, set OLLAMA_BASE_URL=https://ollama.com and OLLAMA_API_KEY.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Security Configuration
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3000
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50

# Drug API Configuration
DRUG_API_URL=http://drug-api:8000/api

# Meilisearch Configuration (full-text search engine)
# MEILISEARCH_KEY is used both as MEILI_MASTER_KEY inside the container
# and as the API key that the drug-api uses to connect.
MEILISEARCH_KEY=dosefinder_meili_key
# Set to 1 to automatically index all drugs into Meilisearch when drug-api starts.
# Useful after first deploy or after a full DB restore. Leave 0 for normal restarts.
SEARCH_SYNC_ON_STARTUP=0

# Email Verification Configuration
# Use your Gmail address here, or a matching alias configured in Gmail/Google Workspace.
EMAIL_FROM=mohamedainmc@gmail.com
CONTACT_EMAIL=info@dosefinder.com
EMAIL_VERIFY_BASE_URL=http://localhost:8080/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_OTP_TTL_MINUTES=15

# SMTP Configuration (Google / Gmail SMTP)
# For personal Gmail, use an App Password instead of your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mohamedainmc@gmail.com
SMTP_PASS=ktne dfda veqv dmjn
SMTP_SECURE=true

# Logging Configuration
# Leave blank to use backend/logs locally or /usr/src/app/logs in Docker.
LOG_DIR=
LOG_TO_FILE=true
LOG_DEBUG_TO_FILE=true
